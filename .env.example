ENVIRONMENT=development

POSTGRES_DB=data_agent
POSTGRES_USER=data_agent
POSTGRES_PASSWORD=data_agent_dev
POSTGRES_PORT=5432

CLICKHOUSE_DB=production_benchmark
CLICKHOUSE_USER=data_agent
CLICKHOUSE_PASSWORD=data_agent_dev
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

REDIS_PASSWORD=data_agent_dev
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://data_agent:data_agent_dev@127.0.0.1:5432/data_agent
QUERY_UNDERSTANDING_PROVIDER=metric_center
QUERY_UNDERSTANDING_URL=
QUERY_UNDERSTANDING_TOKEN=
QUERY_UNDERSTANDING_TIMEOUT_SECONDS=15
# Optional constrained candidate judge. disabled keeps all uncertain cases fail-closed.
# Use METRIC_JUDGE_PROVIDER=dashscope with DASHSCOPE_API_KEY, or
# METRIC_JUDGE_PROVIDER=http with METRIC_JUDGE_URL and METRIC_JUDGE_TOKEN.
METRIC_JUDGE_PROVIDER=disabled
METRIC_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
METRIC_JUDGE_URL=
METRIC_JUDGE_TOKEN=
METRIC_JUDGE_MODEL=qwen-plus
METRIC_JUDGE_TIMEOUT_SECONDS=15
METRIC_JUDGE_MIN_CONFIDENCE=0.70
# Native DeepSeek judge. deepseek-chat is scheduled for retirement on 2026-07-24.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
METRIC_ADJUDICATION_TOKEN_TTL_SECONDS=300
EMBEDDING_PROVIDER=local_sentence_transformer
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=BAAI-bge-small-zh-v1.5-padded-1024
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=10
DASHSCOPE_API_KEY=

# Default: fully local semantic retrieval; no query or metric text leaves the machine.
LOCAL_SENTENCE_TRANSFORMER_MODEL=.models/bge-small-zh-v1.5
LOCAL_SENTENCE_TRANSFORMER_DEVICE=cpu
LOCAL_SENTENCE_TRANSFORMER_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
LOCAL_SENTENCE_TRANSFORMER_MIN_POSITIVE_SIMILARITY=0.45
# Optional DashScope mode: set EMBEDDING_PROVIDER=dashscope,
# EMBEDDING_MODEL=text-embedding-v3, VECTOR_MIN_POSITIVE_SIMILARITY=0.70,
# DASHSCOPE_API_KEY, and RERANKER_ENABLED=true after external-data approval.
VECTOR_SEARCH_LIMIT=5
VECTOR_SIMILARITY_THRESHOLD=0.45
VECTOR_MIN_POSITIVE_SIMILARITY=0.70
VECTOR_SCOPE_NEGATIVE_THRESHOLD=0.64
VECTOR_SCOPE_MARGIN=0.06
RERANKER_ENABLED=false
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANKER_MODEL=qwen3-rerank
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATE_LIMIT=5
RERANKER_WEIGHT=0.30
CLICKHOUSE_READER_USER=chatbi_reader
CLICKHOUSE_READER_PASSWORD=chatbi_reader_dev
CLICKHOUSE_COMPILER_USER=data_agent
CLICKHOUSE_COMPILER_PASSWORD=data_agent_dev
CHATBI_API_TOKEN=change-me-local-chatbi-token
DEMO_IDENTITY_TOKEN=change-me-demo-identity-token
SIGNING_SECRET=change-me-local-signing-secret
