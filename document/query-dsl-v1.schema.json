{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chatbi/query-dsl-v1.schema.json",
  "title": "ChatBI Query DSL 1.0",
  "description": "A warehouse-independent semantic query contract. It must never contain SQL, physical table names, joins, credentials, or permission expressions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dsl_version",
    "intent",
    "metrics",
    "dimensions",
    "filters",
    "time_range",
    "sort",
    "limit"
  ],
  "properties": {
    "dsl_version": {
      "const": "1.0",
      "description": "Semantic query protocol version, not the Dify app DSL version."
    },
    "intent": {
      "type": "string",
      "enum": [
        "aggregate_query",
        "trend_query",
        "comparison_query",
        "ranking_query"
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "time_range": {
      "$ref": "#/$defs/timeRange"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "sort": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/sortItem"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "trend_query"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "dimensions": {
            "contains": {
              "properties": {
                "dimension_id": {
                  "enum": ["D_DATE", "D_WEEK", "D_MONTH", "D_QUARTER"]
                }
              },
              "required": ["dimension_id"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "comparison_query"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "required": ["comparison"]
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "ranking_query"
          }
        },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "dimensions": {
            "minItems": 1
          },
          "sort": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "metric_version", "aggregation"],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^M_[A-Z0-9_]{2,100}$"
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "default",
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "count_distinct"
          ],
          "description": "The Validator must reject an override that the metric definition does not allow."
        },
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id"],
      "properties": {
        "dimension_id": {
          "type": "string",
          "pattern": "^D_[A-Z0-9_]{2,100}$"
        },
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        }
      }
    },
    "filterValue": {
      "oneOf": [
        {"type": "string", "maxLength": 500},
        {"type": "number"},
        {"type": "boolean"}
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "operator", "values"],
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^(D|M)_[A-Z0-9_]{2,100}$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte",
            "between",
            "contains",
            "is_null",
            "is_not_null"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/filterValue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "between"
              }
            },
            "required": ["operator"]
          },
          "then": {
            "properties": {
              "values": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["is_null", "is_not_null"]
              }
            },
            "required": ["operator"]
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+\u002d]+)+$",
          "examples": ["Asia/Shanghai"]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["period_over_period", "year_over_year", "custom"]
        },
        "custom_range": {
          "$ref": "#/$defs/timeRange"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "custom"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["custom_range"]
          },
          "else": {
            "not": {
              "required": ["custom_range"]
            }
          }
        }
      ]
    },
    "sortItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "direction"],
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^(D|M)_[A-Z0-9_]{2,100}$"
        },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"]
        }
      }
    }
  },
  "examples": [
    {
      "dsl_version": "1.0",
      "intent": "trend_query",
      "metrics": [
        {
          "metric_id": "M_SALES_GROSS_MARGIN_RATE",
          "metric_version": 1,
          "aggregation": "default"
        }
      ],
      "dimensions": [
        {"dimension_id": "D_MONTH"},
        {"dimension_id": "D_REGION"}
      ],
      "filters": [
        {
          "field_id": "D_SALES_CHANNEL",
          "operator": "eq",
          "values": ["offline"]
        }
      ],
      "time_range": {
        "start": "2026-01-01",
        "end": "2026-12-31",
        "timezone": "Asia/Shanghai"
      },
      "comparison": {
        "mode": "period_over_period"
      },
      "sort": [
        {"field_id": "D_MONTH", "direction": "asc"}
      ],
      "limit": 500
    }
  ]
}
